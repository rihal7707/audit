# Environment configuration for AMARKETING audit platform
# -----------------------------------------------------
# Gemini AI configuration
GEMINI_API_KEY=                # Your Google Gemini API key (required for live audits)
GEMINI_MODEL=gemini-3.8-flash   # Primary model; if unavailable fallback will be used
GEMINI_FALLBACK_MODEL=        # Optional fallback model (e.g., gemini-3.5-flash-lite)
GEMINI_PAID_TIER=false        # Set true if using paid tier for EEA/UK/CH access

# Video generation (optional, uses same quota if VIDEO_API_KEY empty)
VIDEO_API_KEY=                 # Optional separate key for video generation
VIDEO_MODEL=                  # Model for video generation, fallback to GEMINI_MODEL if empty

# Database configuration (SQLite file path or libSQL URL)
DATABASE_URL=file:./data/amarketing.db   # Local SQLite file; change for hosted libSQL/Turso
DATABASE_AUTH_TOKEN=          # Token for hosted libSQL databases (optional)

# Admin authentication and session settings
ADMIN_PASSWORD=               # Development admin password (will be auto‑generated if empty)
ADMIN_SESSION_SECRET=        # 32‑byte hex secret (auto‑generated by setup script)
ADMIN_PASSWORD_HASH=          # Optional pre‑hashed password (override ADMIN_PASSWORD)

# Security & rate limiting
MAX_AUDITS_PER_DAY=40        # Max audits a single client can request per day
CRON_SECRET=                 # Secret for internal cron endpoints (auto‑generated)
TURNSTILE_SITE_KEY=          # Cloudflare Turnstile site key for form protection
TURNSTILE_SECRET_KEY=        # Cloudflare Turnstile secret key
TRUST_PROXY=false            # Set true when behind a trusted reverse proxy

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000   # Base URL for the app (used in emails, redirects)
NEXT_PUBLIC_BOOKING_URL=                     # URL to your booking/scheduling page (optional)
BUSINESS_CONTACT_EMAIL=   # Contact email address displayed on the site

# Email / notifications (optional)
RESEND_API_KEY=            # API key for Resend email service
FROM_EMAIL=                # Sender email address for outgoing notifications
NOTIFY_WEBHOOK_URL=        # Optional webhook URL for audit events

# Report generation settings
REPORT_RELEASE_MODE=auto   # "auto" to release reports immediately, "review" for admin approval
DATA_RETENTION_DAYS=180    # How many days to keep audit data before auto‑purge
CRAWL_CACHE_TTL_HOURS=24   # Cache TTL for site crawl results

# Feature flags (optional)
ENABLE_WALKTHROUGH=false   # Enable animated walkthrough in the audit wizard

# Miscellaneous
TRUST_PR=                  # Trust proxy setting for platforms like Vercel (optional)

# Ask Your Audit AI Assistant (optional tuning)
ASSISTANT_ENABLED=true
ASSISTANT_MAX_USER_MESSAGES_PER_AUDIT=10
ASSISTANT_MAX_MESSAGE_CHARS=3000
ASSISTANT_HISTORY_MESSAGES=6
ASSISTANT_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_CALLS_PER_DAY=200
