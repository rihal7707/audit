# Production environment template for Vercel (copy to .env.vercel locally; never commit real secrets)

# Hosted libSQL / Turso database (required in production; file: SQLite is rejected on Vercel)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Optional Turso marketplace aliases (accepted automatically if DATABASE_URL is unset)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Google Gemini AI (required for live audit reports and assistant replies)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_PAID_TIER=false

# Admin & internal secrets (run `npm run env:check` to auto-generate strong random values in .env.vercel)
# ADMIN_PASSWORD must be >= 12 chars; ADMIN_SESSION_SECRET must be >= 32 chars
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CRON_SECRET=

# Optional smoke-test bypass secret (remove from Vercel after launch verification)
SMOKE_TEST_SECRET=
# Optional Vercel Deployment Protection bypass secret for automated smoke scripts
VERCEL_AUTOMATION_BYPASS_SECRET=

# App URL (leave empty on first deploy or set to https://your-project.vercel.app; rebuild if changed)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BOOKING_URL=
BUSINESS_CONTACT_EMAIL=hello@amarketing.example

# Proxy & rate-limit behaviour (defaults to true automatically on Vercel)
TRUST_PROXY=true

# Audit pipeline & retention
REPORT_RELEASE_MODE=auto
MAX_AUDITS_PER_DAY=40
DATA_RETENTION_DAYS=180
CRAWL_CACHE_TTL_HOURS=24

# Optional integrations (gracefully disabled when absent)
RESEND_API_KEY=
FROM_EMAIL=
NOTIFY_WEBHOOK_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Video feature (automatically disabled on Vercel when local)
VIDEO_STORAGE=local

# AI Assistant tuning
ASSISTANT_ENABLED=true
ASSISTANT_MAX_USER_MESSAGES_PER_AUDIT=10
ASSISTANT_MAX_MESSAGE_CHARS=3000
ASSISTANT_HISTORY_MESSAGES=6
ASSISTANT_MAX_OUTPUT_TOKENS=800
ASSISTANT_MAX_CALLS_PER_DAY=200
